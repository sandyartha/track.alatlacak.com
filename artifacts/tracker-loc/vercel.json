{
  "buildCommand": "cd ../.. && pnpm install && pnpm --filter @workspace/tracker-loc run build",
  "outputDirectory": "dist/public",
  "installCommand": "echo 'install handled by buildCommand'",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "BASE_PATH": "/"
  }
}
